# Local secrets only: run python3 scripts/configure.py to generate these.
SECRET_KEY=
POSTGRES_PASSWORD=
DEMO_PASSWORD=
COMPOSE_APP_PORT=5050
APP_HOST=127.0.0.1
APP_PORT=5000
COOKIE_SECURE=false
DATA_LABEL=Real cached records; partial SCOPE coverage and unresolved matches
# Compose sets DATABASE_URL automatically. For an independently managed PostgreSQL
# server only, set DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
